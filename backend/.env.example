# Azure OpenAI (PRIMARY feedback provider)
AZURE_OPENAI_API_KEY=
# Provide EITHER the full endpoint URL...
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# ...OR just the resource name (endpoint is derived as https://<name>.openai.azure.com)
AZURE_OPENAI_RESOURCE_NAME=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Google Gemini API key (FALLBACK — get one free at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Feedback provider settings
MAX_RETRIES=2
RETRY_DELAY=2

# ImageKit.io for audio storage (get credentials from https://imagekit.io/dashboard/developer)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# ---------------------------------------------------------------------------
# Optional overrides (sensible defaults applied in config.py — uncomment to change)
# ---------------------------------------------------------------------------
# LOG_LEVEL=INFO
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173   # comma-separated
# GEMINI_MODEL=gemini-3-flash-preview
# WHISPER_MODEL=base                  # tiny | base | small | ...
# SSE_POLL_INTERVAL=0.2               # seconds between progress-stream polls
# SSE_DRAIN_DELAY=0.1
# MAX_UPLOAD_BYTES=104857600          # 100 MB
# MAX_QUESTION_LEN=2000
# MAX_CODE_LEN=10000
# SESSION_STORE_MAX=100               # max in-memory sessions before eviction
# SESSION_TTL_SECONDS=3600            # evict finished sessions older than this
